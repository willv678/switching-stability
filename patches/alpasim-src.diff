@@ -0,0 +1,97 @@
+# SPDX-License-Identifier: Apache-2.0
+# Copyright (c) 2026 NVIDIA Corporation
+
+import numpy as np
+import pytest
+from alpasim_runtime.config import FaultInjectionConfig
+from alpasim_runtime.plan_fault_injection import PlanFaultState, apply_plan_fault_injection
+from alpasim_utils.geometry import Pose, Trajectory
+
+
+def _straight_trajectory(n: int = 10, dt_us: int = 100_000) -> Trajectory:
+    timestamps = np.arange(n, dtype=np.uint64) * dt_us
+    poses = [
+        Pose(
+            np.array([float(i), 0.0, 0.0], dtype=np.float32),
+            np.array([0.0, 0.0, 0.0, 1.0], dtype=np.float32),
+        )
+        for i in range(n)
+    ]
+    return Trajectory.from_poses(timestamps, poses)
+
+
+def test_disabled_returns_same_object() -> None:
+    traj = _straight_trajectory()
+    config = FaultInjectionConfig(enabled=False, lateral_bias_m=1.0)
+    result = apply_plan_fault_injection(
+        traj, config, step_start_us=0, step_index=0, state=PlanFaultState(), session_seed=0
+    )
+    assert result is traj
+
+
+def test_lateral_bias_shifts_y() -> None:
+    traj = _straight_trajectory()
+    config = FaultInjectionConfig(enabled=True, lateral_bias_m=1.0)
+    result = apply_plan_fault_injection(
+        traj, config, step_start_us=0, step_index=0, state=PlanFaultState(), session_seed=0
+    )
+    assert result.positions[0, 1] == pytest.approx(1.0, abs=1e-5)
+    assert result.positions[0, 0] == pytest.approx(0.0, abs=1e-5)
+
+
+def test_waypoint_noise_is_deterministic() -> None:
+    traj = _straight_trajectory()
+    config = FaultInjectionConfig(enabled=True, waypoint_noise_std=0.5)
+    state_a = PlanFaultState()
+    state_b = PlanFaultState()
+    result_a = apply_plan_fault_injection(
+        traj, config, step_start_us=0, step_index=3, state=state_a, session_seed=42
+    )
+    result_b = apply_plan_fault_injection(
+        traj, config, step_start_us=0, step_index=3, state=state_b, session_seed=42
+    )
+    np.testing.assert_allclose(result_a.positions, result_b.positions)
+
+
+def test_freeze_plan_reuses_previous_trajectory() -> None:
+    traj_a = _straight_trajectory()
+    traj_b = Trajectory.from_poses(
+        np.arange(10, dtype=np.uint64) * 100_000,
+        [
+            Pose(
+                np.array([float(i) + 100.0, 0.0, 0.0], dtype=np.float32),
+                np.array([0.0, 0.0, 0.0, 1.0], dtype=np.float32),
+            )
+            for i in range(10)
+        ],
+    )
+    config = FaultInjectionConfig(enabled=True, freeze_plan_steps=2)
+    state = PlanFaultState()
+
+    first = apply_plan_fault_injection(
+        traj_a, config, step_start_us=0, step_index=0, state=state, session_seed=0
+    )
+    second = apply_plan_fault_injection(
+        traj_b, config, step_start_us=100_000, step_index=1, state=state, session_seed=0
+    )
+    third = apply_plan_fault_injection(
+        traj_b, config, step_start_us=200_000, step_index=2, state=state, session_seed=0
+    )
+
+    np.testing.assert_allclose(first.positions, traj_a.positions)
+    np.testing.assert_allclose(second.positions, traj_a.positions)
+    np.testing.assert_allclose(third.positions, traj_b.positions)
+
+
+def test_truncate_horizon_shortens_trajectory() -> None:
+    traj = _straight_trajectory(n=20, dt_us=100_000)
+    config = FaultInjectionConfig(enabled=True, truncate_horizon_s=0.5)
+    result = apply_plan_fault_injection(
+        traj,
+        config,
+        step_start_us=0,
+        step_index=0,
+        state=PlanFaultState(),
+        session_seed=0,
+    )
+    assert result.timestamps_us[-1] <= 500_000
