+def _make_initial_state(timestamp_us: int = 1_000_000) -> common_pb2.StateAtTime:
+    state = common_pb2.StateAtTime()
+    state.timestamp_us = timestamp_us
+    state.pose.vec.x = 0.0
+    state.pose.vec.y = 0.0
+    state.pose.quat.w = 1.0
+    state.state.linear_velocity.x = 5.0
+    return state
+
+
+def _fill_straight_plan(
+    request: controller_pb2.RunControllerAndVehicleModelRequest,
+    t0: int,
+    n: int = 20,
+    dt_us: int = 100_000,
+) -> None:
+    for i in range(n):
+        pose = request.planned_trajectory_in_rig.poses.add()
+        pose.timestamp_us = t0 + i * dt_us
+        pose.pose.vec.x = 5.0 * i * dt_us / 1e6
+        pose.pose.quat.w = 1.0
+
+
+def test_create_system_kinematic_ideal() -> None:
+    with tempfile.NamedTemporaryFile(mode="w", suffix=".csv", delete=False) as f:
+        log_file = f.name
+    try:
+        system = create_system(
+            log_file=log_file,
+            initial_state=_make_initial_state(),
+            controller_config=ControllerConfig(mpc_implementation="kinematic_ideal"),
+        )
+        assert system._kinematic_ideal is True
+    finally:
+        if os.path.exists(log_file):
+            os.unlink(log_file)
+
+
+def test_kinematic_ideal_matches_plan_waypoint() -> None:
+    with tempfile.NamedTemporaryFile(mode="w", suffix=".csv", delete=False) as f:
+        log_file = f.name
+    try:
+        t0 = 1_000_000
+        system = create_system(
+            log_file=log_file,
+            initial_state=_make_initial_state(t0),
+            controller_config=ControllerConfig(mpc_implementation="kinematic_ideal"),
+        )
+
+        request = controller_pb2.RunControllerAndVehicleModelRequest()
+        request.state.CopyFrom(_make_initial_state(t0))
+        _fill_straight_plan(request, t0)
+        request.future_time_us = t0 + 100_000
+
+        response = system.run_controller_and_vehicle_model(request)
+        final_pose = response.states[-1].pose_local_to_rig
+
+        expected = Trajectory.from_poses(
+            np.array([t0 + 100_000], dtype=np.uint64),
+            [
+                Pose(
+                    np.array([0.5, 0.0, 0.0], dtype=np.float32),
+                    np.array([0.0, 0.0, 0.0, 1.0], dtype=np.float32),
+                )
+            ],
+        ).last_pose
+
+        assert final_pose.vec.x == pytest.approx(expected.vec3[0], abs=1e-4)
+        assert final_pose.vec.y == pytest.approx(expected.vec3[1], abs=1e-4)
+    finally:
+        if os.path.exists(log_file):
+            os.unlink(log_file)
