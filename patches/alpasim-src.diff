index 0000000..0b396b4
--- /dev/null
+++ b/src/controller/alpasim_controller/gains_codec.py
@@ -0,0 +1,54 @@
+# SPDX-License-Identifier: Apache-2.0
+# Copyright (c) 2026 NVIDIA Corporation
+
+"""Conversion helpers between MPCGains and controller gRPC messages."""
+
+import hashlib
+import json
+
+from alpasim_controller.mpc_controller import MPCGains
+from alpasim_grpc.v0 import controller_pb2
+
+
+def mpc_gains_to_proto(gains: MPCGains) -> controller_pb2.MPCGainsUpdate:
+    """Serialize MPCGains to a controller RPC message."""
+    return controller_pb2.MPCGainsUpdate(
+        long_position_weight=gains.long_position_weight,
+        lat_position_weight=gains.lat_position_weight,
+        heading_weight=gains.heading_weight,
+        acceleration_weight=gains.acceleration_weight,
+        rel_front_steering_angle_weight=gains.rel_front_steering_angle_weight,
+        rel_acceleration_weight=gains.rel_acceleration_weight,
+        idx_start_penalty=gains.idx_start_penalty,
+    )
+
+
+def gains_hash(gains: MPCGains) -> str:
+    """Return a short stable hash for the active gain set."""
+    payload = json.dumps(
+        {
+            "long_position_weight": gains.long_position_weight,
+            "lat_position_weight": gains.lat_position_weight,
+            "heading_weight": gains.heading_weight,
+            "acceleration_weight": gains.acceleration_weight,
+            "rel_front_steering_angle_weight": gains.rel_front_steering_angle_weight,
+            "rel_acceleration_weight": gains.rel_acceleration_weight,
+            "idx_start_penalty": gains.idx_start_penalty,
+        },
+        sort_keys=True,
+        separators=(",", ":"),
+    )
+    return hashlib.sha256(payload.encode()).hexdigest()[:16]
+
+
+def mpc_gains_from_proto(message: controller_pb2.MPCGainsUpdate) -> MPCGains:
+    """Deserialize MPCGains from a controller RPC message."""
+    return MPCGains(
+        long_position_weight=message.long_position_weight,
+        lat_position_weight=message.lat_position_weight,
+        heading_weight=message.heading_weight,
+        acceleration_weight=message.acceleration_weight,
+        rel_front_steering_angle_weight=message.rel_front_steering_angle_weight,
+        rel_acceleration_weight=message.rel_acceleration_weight,
+        idx_start_penalty=message.idx_start_penalty,
+    )
