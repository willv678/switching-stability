@@ -0,0 +1,98 @@
+# SPDX-License-Identifier: Apache-2.0
+# Copyright (c) 2026 NVIDIA Corporation
+
+import numpy as np
+import pytest
+from alpasim_grpc.v0.logging_pb2 import RolloutMetadata
+from alpasim_utils.geometry import Pose, Trajectory
+from conftest import create_test_eval_config
+
+from eval.data import (
+    RAABB,
+    ActorPolygons,
+    Cameras,
+    DriverResponseAtTime,
+    DriverResponses,
+    RenderableTrajectory,
+    Routes,
+    SimulationResult,
+)
+from eval.scorers.tracking_error import TrackingErrorScorer
+
+
+def _trajectory(timestamps_us: np.ndarray, x_offset: float = 0.0) -> Trajectory:
+    positions = np.stack(
+        [
+            timestamps_us.astype(np.float32) / 1_000_000.0 + x_offset,
+            np.zeros(len(timestamps_us), dtype=np.float32),
+            np.zeros(len(timestamps_us), dtype=np.float32),
+        ],
+        axis=1,
+    )
+    quaternions = np.tile(
+        np.array([[0.0, 0.0, 0.0, 1.0]], dtype=np.float32),
+        (len(timestamps_us), 1),
+    )
+    return Trajectory(timestamps_us, positions, quaternions)
+
+
+def _simulation_result(
+    ego_traj: RenderableTrajectory,
+    plan_traj: RenderableTrajectory,
+    rig_to_aabb: Pose,
+    now_us: int,
+) -> SimulationResult:
+    raabb = RAABB(size_x=4.5, size_y=2.0, size_z=1.5, corner_radius_m=0.0)
+    driver_responses = DriverResponses(
+        ego_coords_rig_to_aabb_center=rig_to_aabb,
+        ego_trajectory_local=ego_traj,
+        per_timestep_driver_responses=[
+            DriverResponseAtTime(
+                now_time_us=now_us,
+                time_query_us=now_us,
+                selected_trajectory=plan_traj,
+                sampled_trajectories=[plan_traj],
+            )
+        ],
+    )
+    return SimulationResult(
+        session_metadata=RolloutMetadata.SessionMetadata(
+            session_uuid="test",
+            scene_id="test",
+            batch_size=1,
+            n_sim_steps=len(ego_traj),
+            start_timestamp_us=int(ego_traj.timestamps_us[0]),
+            control_timestep_us=100_000,
+        ),
+        ego_coords_rig_to_aabb_center=rig_to_aabb,
+        actor_trajectories={"EGO": ego_traj},
+        driver_estimated_trajectory=ego_traj,
+        driver_responses=driver_responses,
+        ego_recorded_ground_truth_trajectory=ego_traj,
+        vec_map=None,
+        actor_polygons=ActorPolygons.from_actor_trajectories({"EGO": ego_traj}),
+        cameras=Cameras(),
+        routes=Routes(),
+    )
+
+
+def test_tracking_error_zero_when_plan_matches_ego_in_aabb_frame() -> None:
+    timestamps = np.arange(0, 1_000_000, 100_000, dtype=np.uint64)
+    rig_to_aabb = Pose(
+        np.array([1.0, 0.0, 0.0], dtype=np.float32),
+        np.array([0.0, 0.0, 0.0, 1.0], dtype=np.float32),
+    )
+    raabb = RAABB(size_x=4.5, size_y=2.0, size_z=1.5, corner_radius_m=0.0)
+    ego_rig = RenderableTrajectory.from_trajectory(_trajectory(timestamps), raabb)
+    ego_aabb = ego_rig.transform(rig_to_aabb, is_relative=True)
+    plan_aabb = ego_aabb
+
+    result = _simulation_result(
+        ego_traj=ego_aabb,
+        plan_traj=plan_aabb,
+        rig_to_aabb=rig_to_aabb,
+        now_us=0,
+    )
+    metric = TrackingErrorScorer(create_test_eval_config()).calculate(result)[0]
+    assert metric.valid == [True]
+    assert metric.values[0] == pytest.approx(0.0, abs=1e-5)
