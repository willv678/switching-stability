+        # the first plan waypoint matches the ego pose TrackingErrorScorer uses.
+        self._plan_start_pose = self._trajectory.last_pose
+        local_poses = [
+            self._plan_start_pose @ self._reference_trajectory.get_pose(i)
+            for i in range(len(self._reference_trajectory))
+        ]
+        if local_poses:
+            local_poses[0] = self._plan_start_pose
+        self._local_reference_trajectory = Trajectory.from_poses(
+            timestamps=self._reference_trajectory.timestamps_us.copy(),
+            poses=local_poses,
