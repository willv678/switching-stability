+# SPDX-License-Identifier: Apache-2.0
+# Copyright (c) 2026 NVIDIA Corporation
+
+"""Step-based controller gain schedule resolution."""
+
+from __future__ import annotations
+
+from alpasim_runtime.config import ControllerGainScheduleEntry, ControllerGainsConfig
+from alpasim_runtime.unbound_rollout import UnboundRollout
+
+
+def control_step_index(step_start_us: int, unbound: UnboundRollout) -> int:
+    """Return the closed-loop control step index for a controller event."""
+    if step_start_us < unbound.first_policy_timestamp_us:
+        return 0
+    return (
+        step_start_us - unbound.first_policy_timestamp_us
+    ) // unbound.control_timestep_us
+
+
+def resolve_controller_gains(
+    base_gains: ControllerGainsConfig | None,
+    schedule: list[ControllerGainScheduleEntry],
+    step_index: int,
+) -> ControllerGainsConfig | None:
+    """Resolve active MPC gains for a control step.
+
+    The base gains apply before the first schedule entry. Each schedule entry
+    replaces the active gains once ``step_index >= entry.step``.
+    """
+    if base_gains is None and not schedule:
+        return None
+
+    active = base_gains or ControllerGainsConfig()
+    for entry in sorted(schedule, key=lambda item: item.step):
+        if step_index >= entry.step:
+            active = entry.gains
+    return active
