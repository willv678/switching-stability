+class TestLinearMPCGainUpdates:
+    """Tests for mid-rollout Q/R updates."""
+
+    def test_update_gains_rebuilds_cost_matrices(self):
+        """update_gains should replace Q/R diagonal entries."""
+        controller = LinearMPC()
+        original_q_diag = np.diag(controller._Q).copy()
+
+        controller.update_gains(
+            MPCGains(
+                long_position_weight=8.0,
+                lat_position_weight=4.0,
+                heading_weight=3.0,
+                acceleration_weight=0.5,
+                rel_front_steering_angle_weight=2.0,
+                rel_acceleration_weight=0.25,
+                idx_start_penalty=0,
+            )
+        )
+
+        new_q_diag = np.diag(controller._Q)
+        new_r_diag = np.diag(controller._R)
+        assert not np.allclose(new_q_diag, original_q_diag)
+        assert new_q_diag[0] == 8.0
+        assert new_q_diag[1] == 4.0
+        assert new_r_diag[0] == 2.0
+        assert controller._gains.idx_start_penalty == 0
+
+
+class TestLinearMPCTerminalCost:
+    """Tests for Riccati terminal cost computation."""
+
+    def test_riccati_terminal_cost_differs_from_stage(self):
+        """Riccati mode should produce a distinct terminal penalty."""
+        riccati_controller = LinearMPC(terminal_cost="riccati")
+        stage_controller = LinearMPC(terminal_cost="stage")
+        state = np.zeros(riccati_controller.NX)
+        state[riccati_controller.IVX] = 10.0
+
+        A_d, B_d = riccati_controller._linearize_dynamics(state)
+        Qf_riccati = riccati_controller._compute_terminal_cost(A_d, B_d)
+        Qf_stage = stage_controller._compute_terminal_cost(A_d, B_d)
+
+        assert not np.allclose(Qf_riccati, Qf_stage)
+        np.testing.assert_allclose(Qf_riccati, Qf_riccati.T, atol=1e-10)
+
+    def test_stage_terminal_cost_matches_q(self):
+        """Stage mode should use the stage cost matrix as terminal cost."""
+        controller = LinearMPC(terminal_cost="stage")
+        state = np.zeros(controller.NX)
+        state[controller.IVX] = 10.0
+
+        A_d, B_d = controller._linearize_dynamics(state)
+        Qf = controller._compute_terminal_cost(A_d, B_d)
+
+        np.testing.assert_allclose(Qf, controller._Q)
+
+
