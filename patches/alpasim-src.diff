index 0000000..82c325f
--- /dev/null
+++ b/src/eval/src/eval/scorers/tracking_error.py
@@ -0,0 +1,101 @@
+# SPDX-License-Identifier: Apache-2.0
+# Copyright (c) 2026 NVIDIA Corporation
+
+import numpy as np
+
+from eval.data import AggregationType, MetricReturn, SimulationResult
+from eval.schema import EvalConfig, TrackingErrorScorerConfig
+from eval.scorers.base import Scorer
+
+
+class TrackingErrorScorer(Scorer):
+    """Scores how well the tracker followed each planned trajectory.
+
+    At every inference step the driver returns a planned trajectory. This
+    scorer compares the plan interpolated at future timestamps against the
+    executed ego pose in ``actor_trajectories["EGO"]`` at those same absolute
+    times. Unlike ``plan_deviation`` (which compares consecutive plans), this
+    measures tracking error: how closely the vehicle followed the plan it was
+    given.
+
+    Metric name: ``tracking_error`` — mean L2 distance in metres between the
+    planned and executed poses over future plan timestamps within the horizon.
+    Aggregated with MEAN across inference steps. Steps whose plan has no future
+    pose within the horizon, or no overlapping executed ego pose, are marked
+    invalid and excluded from aggregation.
+    """
+
+    def __init__(self, cfg: EvalConfig) -> None:
+        super().__init__(cfg)
+        scorer_config: TrackingErrorScorerConfig = cfg.scorers.tracking_error
+        self.horizon_us = round(scorer_config.horizon_s * 1e6)
+        if self.horizon_us <= 0:
+            raise ValueError(
+                "scorers.tracking_error.horizon_s must be > 0 (>= 1e-6 s), got "
+                f"{scorer_config.horizon_s}"
+            )
+        self.incl_z = scorer_config.incl_z
+
+    def calculate(self, simulation_result: SimulationResult) -> list[MetricReturn]:
+        # EGO actor poses in ASL are already logged in AABB frame (see
+        # runtime StepEvent.log_actor_poses). Driver selected_trajectory is
+        # also stored in AABB frame, so compare both directly.
+        ego_trajectory = simulation_result.actor_trajectories["EGO"]
+
+        timestamps_us: list[int] = []
+        tracking_errors: list[float] = []
+        valids: list[bool] = []
+
+        responses = simulation_result.driver_responses.per_timestep_driver_responses
+        for response in responses:
+            now_us = response.now_time_us
+            plan = response.selected_trajectory
+            timestamps_us.append(now_us)
+
+            # The first plan pose is the current ego pose, so only strictly
+            # future poses within the horizon form the tracking-error check.
+            plan_timestamps = np.asarray(plan.timestamps_us)
+            in_horizon = (plan_timestamps > now_us) & (
+                plan_timestamps <= now_us + self.horizon_us
+            )
+            future_timestamps = plan_timestamps[in_horizon]
+            if len(future_timestamps) == 0:
+                tracking_errors.append(0.0)
+                valids.append(False)
+                continue
+
+            scorable_timestamps = [
+                int(ts)
+                for ts in future_timestamps
+                if int(ts) in ego_trajectory.time_range_us
+            ]
+            if len(scorable_timestamps) == 0:
+                tracking_errors.append(0.0)
+                valids.append(False)
+                continue
+
+            scorable_timestamps_arr = np.asarray(scorable_timestamps, dtype=np.uint64)
+            planned_positions = plan.interpolate_to_timestamps(
+                scorable_timestamps_arr
+            ).positions
+            executed_positions = ego_trajectory.interpolate_to_timestamps(
+                scorable_timestamps_arr
+            ).positions
+
+            delta_xyz = planned_positions - executed_positions
+            distances = np.linalg.norm(
+                delta_xyz if self.incl_z else delta_xyz[..., :2], axis=-1
+            )
+
+            valids.append(True)
+            tracking_errors.append(float(np.mean(distances)))
+
+        return [
+            MetricReturn(
+                name="tracking_error",
+                values=tracking_errors,
+                valid=valids,
+                timestamps_us=timestamps_us,
+                time_aggregation=AggregationType.MEAN,
+            )
+        ]
