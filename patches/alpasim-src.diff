+# SPDX-License-Identifier: Apache-2.0
+# Copyright (c) 2026 NVIDIA Corporation
+
+"""Plan corruption hooks applied before controller tracking."""
+
+from __future__ import annotations
+
+import math
+from dataclasses import dataclass
+
+import numpy as np
+from alpasim_runtime.config import FaultInjectionConfig
+from alpasim_utils.geometry import Trajectory
+
+
+@dataclass
+class PlanFaultState:
+    """Mutable state for multi-step fault injection."""
+
+    frozen_trajectory: Trajectory | None = None
+    freeze_remaining: int = 0
+
+
+def apply_plan_fault_injection(
+    trajectory: Trajectory,
+    config: FaultInjectionConfig,
+    step_start_us: int,
+    step_index: int,
+    state: PlanFaultState,
+    session_seed: int,
+) -> Trajectory:
+    """Return a possibly corrupted copy of the driver plan."""
+    if not config.enabled:
+        return trajectory
+
+    result = trajectory
+
+    if config.freeze_plan_steps > 0:
+        if state.freeze_remaining > 0:
+            if state.frozen_trajectory is None:
+                raise RuntimeError("freeze_plan_steps active but no frozen trajectory")
+            result = state.frozen_trajectory
+            state.freeze_remaining -= 1
+        else:
+            state.frozen_trajectory = trajectory.clone()
+            state.freeze_remaining = config.freeze_plan_steps - 1
+            result = state.frozen_trajectory
+
+    if config.truncate_horizon_s is not None and config.truncate_horizon_s > 0.0:
+        horizon_us = int(config.truncate_horizon_s * 1e6)
+        end_us = step_start_us + horizon_us
+        time_range = result.time_range_us
+        if end_us <= time_range.start:
+            raise ValueError(
+                "truncate_horizon_s leaves no plan waypoints at step_start_us="
+                f"{step_start_us}"
+            )
+        if end_us < time_range.stop:
+            result = result.clip(step_start_us, end_us)
+
+    if config.lateral_bias_m != 0.0:
+        result = _apply_lateral_bias(result, config.lateral_bias_m)
+
+    if config.waypoint_noise_std != 0.0:
+        rng = np.random.default_rng(session_seed + step_index)
+        result = _apply_waypoint_noise(result, config.waypoint_noise_std, rng)
+
+    return result
+
+
+def _apply_lateral_bias(trajectory: Trajectory, bias_m: float) -> Trajectory:
+    positions = trajectory.positions.copy()
+    yaws = trajectory.yaws
+    for i in range(len(positions)):
+        positions[i, 0] += -math.sin(yaws[i]) * bias_m
+        positions[i, 1] += math.cos(yaws[i]) * bias_m
+    return Trajectory(
+        trajectory.timestamps_us.copy(),
+        positions,
+        trajectory.quaternions.copy(),
+    )
+
+
+def _apply_waypoint_noise(
+    trajectory: Trajectory,
+    noise_std: float,
+    rng: np.random.Generator,
+) -> Trajectory:
+    positions = trajectory.positions.copy()
+    noise = rng.normal(0.0, noise_std, size=(len(positions), 2))
+    positions[:, 0] += noise[:, 0]
+    positions[:, 1] += noise[:, 1]
+    return Trajectory(
+        trajectory.timestamps_us.copy(),
+        positions,
+        trajectory.quaternions.copy(),
+    )
