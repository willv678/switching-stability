+# SPDX-License-Identifier: Apache-2.0
+# Copyright (c) 2026 NVIDIA Corporation
+
+from unittest.mock import MagicMock
+
+from alpasim_runtime.config import ControllerGainScheduleEntry, ControllerGainsConfig
+from alpasim_runtime.controller_gain_schedule import (
+    control_step_index,
+    resolve_controller_gains,
+)
+
+
+def _mock_unbound(
+    first_policy_timestamp_us: int = 1_000_000,
+    control_timestep_us: int = 100_000,
+):
+    unbound = MagicMock()
+    unbound.first_policy_timestamp_us = first_policy_timestamp_us
+    unbound.control_timestep_us = control_timestep_us
+    return unbound
+
+
+def test_control_step_index_counts_from_first_policy_timestamp() -> None:
+    unbound = _mock_unbound()
+    assert control_step_index(1_000_000, unbound) == 0
+    assert control_step_index(1_050_000, unbound) == 0
+    assert control_step_index(1_100_000, unbound) == 1
+    assert control_step_index(6_000_000, unbound) == 50
+
+
+def test_resolve_controller_gains_applies_schedule_at_step() -> None:
+    base = ControllerGainsConfig(lat_position_weight=1.0)
+    aggressive = ControllerGainsConfig(lat_position_weight=2.0)
+    schedule = [ControllerGainScheduleEntry(step=50, gains=aggressive)]
+
+    before = resolve_controller_gains(base, schedule, 49)
+    at = resolve_controller_gains(base, schedule, 50)
+    after = resolve_controller_gains(base, schedule, 80)
+
+    assert before is not None and before.lat_position_weight == 1.0
+    assert at is not None and at.lat_position_weight == 2.0
+    assert after is not None and after.lat_position_weight == 2.0
+
+
+def test_resolve_controller_gains_uses_latest_matching_entry() -> None:
+    base = ControllerGainsConfig(lat_position_weight=1.0)
+    schedule = [
+        ControllerGainScheduleEntry(
+            step=10, gains=ControllerGainsConfig(lat_position_weight=1.5)
+        ),
+        ControllerGainScheduleEntry(
+            step=50, gains=ControllerGainsConfig(lat_position_weight=2.0)
+        ),
+    ]
+
+    resolved = resolve_controller_gains(base, schedule, 60)
+    assert resolved is not None
+    assert resolved.lat_position_weight == 2.0
